<Window x:Class="EVETranslate.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:models="clr-namespace:EVETranslate.Models"
	xmlns:viewmodels="clr-namespace:EVETranslate.ViewModels"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="EVETranslate"
        Width="980"
        Height="720"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <DockPanel LastChildFill="True">
        <!-- Top command/menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Settings">
                <MenuItem Header="Preferences..." />
                <Separator/>
                <MenuItem Header="Exit" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="View Help" />
                <MenuItem Header="Keyboard Shortcuts" />
                <Separator/>
                <MenuItem Header="Report Issue" />
            </MenuItem>
            <MenuItem Header="_About">
                <MenuItem Header="About EVETranslate" />
                <MenuItem Header="Licenses" />
            </MenuItem>
        </Menu>
        <!-- Bottom translate/composer bar -->
        <Border DockPanel.Dock="Bottom" BorderThickness="1,1,1,0" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Composer header row -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Outbound translator (type English → copy target language)"/>
                    <ComboBox Grid.Column="1" Margin="12,0,10,0" Width="170" VerticalAlignment="Center" SelectedValuePath="Tag" SelectedValue="{Binding SelectedTargetLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBoxItem Content="Russian (RU)" Tag="{x:Static models:TargetLanguage.RU}" />
                        <ComboBoxItem Content="Chinese (ZH)" Tag="{x:Static models:TargetLanguage.ZH}" />
                    </ComboBox>
                    <Button Grid.Column="2" MinWidth="140" Height="28" VerticalAlignment="Center" Content="Translate + Copy" Command="{Binding TranslateAndCopyCommand}"/>
                </Grid>
                <!-- Composer input row -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- English input -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Text="English input"/>
                        <TextBox Height="72" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" FontSize="13" Text="{Binding OutboundInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Type here. This tool does not send to EVE; you will paste manually."/>
                    </DockPanel>
                    <!-- Translated preview -->
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Text="Translated output (preview)"/>
                        <TextBox Height="72" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" FontSize="13" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" Text="{Binding OutboundTranslatedPreview, Mode=OneWay}" ToolTip="Preview of translated text that will be copied to clipboard."/>
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>
        <!-- Main content area: tabs + translated logs -->
        <Grid>
            <TabControl Margin="10" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}">
                <!-- Tab header: channel name -->
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <!-- Tab content: messages -->
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Per-tab header/status row -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock FontWeight="SemiBold" Text="Translated feed"/>
                                <TextBlock Margin="10,0,0,0" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Text="(watching chat logs...)"/>
                            </DockPanel>
                            <!-- Messages list -->
                            <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" CornerRadius="6" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" Padding="8">
                                <!-- Use ListBox for easy virtualization + selection later -->
                                <ListBox ItemsSource="{Binding Messages}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8" Margin="0,0,0,8" CornerRadius="6" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
                                                <StackPanel>
                                                    <DockPanel LastChildFill="True">
                                                        <Border DockPanel.Dock="Right"
                                                        Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding LanguageTag}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"
                                                        />
                                                        </Border>
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Speaker}" />
                                                        <TextBlock Margin="8,0,0,0" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}">
															<Run Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" />
															<Run Text=" • " />
															<Run Text="{Binding Channel}" />
                                                        </TextBlock>
                                                    </DockPanel>
                                                    <TextBlock Margin="0,6,0,0" FontSize="14" Text="{Binding TranslatedText}" TextWrapping="Wrap"/>
                                                    <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding OriginalText}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <Run Text="Original: " />
                                                        <Run Text="{Binding OriginalText}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <!-- If a tab has zero messages, show a friendly hint -->
                                    <!-- If a tab has zero messages, show a friendly hint -->
                                    <ListBox.Style>
                                        <Style TargetType="{x:Type ListBox}">
                                            <Style.Triggers>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type ListBox}">
                                                                <Grid>
                                                                    <!-- preserve normal list behavior -->
                                                                    <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto">
                                                                        <ItemsPresenter/>
                                                                    </ScrollViewer>
                                                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Text="No messages yet."/>
                                                                </Grid>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                </ListBox>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>