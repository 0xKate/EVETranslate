<Window
    x:Class="EVETranslate.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:EVETranslate.Models"
    xmlns:viewmodels="clr-namespace:EVETranslate.ViewModels"
    xmlns:views="clr-namespace:EVETranslate.Views"
    Title="EVETranslate"
    Width="980"
    Height="720"
    MinWidth="720"
    MinHeight="520"
    d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <DockPanel LastChildFill="True">
        <!--  Top command/menu bar  -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Menu">
                <MenuItem Command="{Binding OpenSettingsCommand}" Header="Settings..." />
                <Separator />
                <MenuItem Command="{Binding ExitAppCommand}" Header="Exit" />
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="View Help" />
                <MenuItem Command="{Binding OpenAboutCommand}" Header="About" />
            </MenuItem>
        </Menu>

        <!--  Bottom translate/composer bar  -->
        <Border
            Padding="10"
            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
            BorderThickness="1,1,1,0"
            DockPanel.Dock="Bottom">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!--  Composer header row  -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Outbound translator (type English → copy target language)" />
                    <ComboBox
                        Grid.Column="1"
                        Width="170"
                        Margin="12,0,10,0"
                        VerticalAlignment="Center"
                        SelectedValue="{Binding SelectedTargetLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectedValuePath="Tag">
                        <ComboBoxItem Content="Russian (RU)" Tag="{x:Static models:TargetLanguage.RU}" />
                        <ComboBoxItem Content="Chinese (ZH)" Tag="{x:Static models:TargetLanguage.ZH}" />
                    </ComboBox>
                    <Button
                        Grid.Column="2"
                        Height="28"
                        MinWidth="140"
                        VerticalAlignment="Center"
                        Command="{Binding TranslateAndCopyCommand}"
                        Content="Translate + Copy" />
                </Grid>
                <!--  Composer input row  -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!--  English input  -->
                    <DockPanel Grid.Column="0">
                        <TextBlock
                            Margin="0,0,0,4"
                            DockPanel.Dock="Top"
                            Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                            Text="English input" />
                        <TextBox
                            Height="72"
                            Padding="8"
                            AcceptsReturn="True"
                            FontSize="13"
                            Text="{Binding OutboundInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            ToolTip="Type here. This tool does not send to EVE; you will paste manually."
                            VerticalScrollBarVisibility="Auto" />
                    </DockPanel>
                    <!--  Translated preview  -->
                    <DockPanel Grid.Column="2">
                        <TextBlock
                            Margin="0,0,0,4"
                            DockPanel.Dock="Top"
                            Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                            Text="Translated output (preview)" />
                        <TextBox
                            Height="72"
                            Padding="8"
                            Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                            FontSize="13"
                            IsReadOnly="True"
                            Text="{Binding OutboundTranslatedPreview, Mode=OneWay}"
                            TextWrapping="Wrap"
                            ToolTip="Preview of translated text that will be copied to clipboard."
                            VerticalScrollBarVisibility="Auto" />
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>
        <!--  Main content area: tabs + translated logs  -->
        <Grid>
            <TabControl
                Margin="10"
                ItemsSource="{Binding Tabs}"
                SelectedItem="{Binding SelectedTab, Mode=TwoWay}">
                <!--  Click Event  -->
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TabItem_PreviewMouseLeftButtonDown" />
                    </Style>
                </TabControl.ItemContainerStyle>
                <!--  Tab header: channel name  -->
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <!--  Tab content: messages  -->
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!--  Per-tab header/status row  -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock FontWeight="SemiBold" Text="Translated feed" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                    Text="(watching chat logs...)" />
                            </DockPanel>
                            <!--  Messages list  -->
                            <Border
                                Grid.Row="1"
                                Padding="8"
                                Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <!--  Use ListBox for easy virtualization + selection later  -->
                                <ListBox
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemsSource="{Binding Messages}"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,0,0,8"
                                                Padding="8"
                                                Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                                                CornerRadius="6">
                                                <StackPanel>
                                                    <DockPanel LastChildFill="True">
                                                        <Border
                                                            Margin="8,0,0,0"
                                                            Padding="6,2"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                                            CornerRadius="4"
                                                            DockPanel.Dock="Right">
                                                            <TextBlock
                                                                FontSize="10"
                                                                FontWeight="SemiBold"
                                                                Foreground="White"
                                                                Text="{Binding LanguageTag}" />
                                                        </Border>
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Speaker}" />
                                                        <TextBlock Margin="8,0,0,0" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}">
                                                            <Run Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" />
                                                            <Run Text=" • " />
                                                            <Run Text="{Binding Channel}" />
                                                        </TextBlock>
                                                    </DockPanel>
                                                    <TextBlock
                                                        Margin="0,6,0,0"
                                                        FontSize="14"
                                                        Text="{Binding TranslatedText}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Margin="0,6,0,0"
                                                        Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                                        TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding OriginalText}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <Run Text="Original: " />
                                                        <Run Text="{Binding OriginalText}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <!--  If a tab has zero messages, show a friendly hint  -->
                                    <ListBox.Style>
                                        <Style TargetType="{x:Type ListBox}">
                                            <Style.Triggers>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type ListBox}">
                                                                <Grid>
                                                                    <!--  preserve normal list behavior  -->
                                                                    <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto">
                                                                        <ItemsPresenter />
                                                                    </ScrollViewer>
                                                                    <TextBlock
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                                                        Text="No messages yet." />
                                                                </Grid>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                </ListBox>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>